{
  "name": "rishikesh_homestays",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "node server.js",
    "start": "node server.js",
    "test": "node --test tests/**/*.test.js",
    "test:watch": "node --test --watch tests/**/*.test.js",
    "test:coverage": "node --test tests/**/*.test.js --coverage",
    "build:stays": "python3 scripts/stays/build_pages.py --city haridwar && python3 scripts/stays/build_pages.py",
    "check:stays": "node --test tests/integration/stays-content.test.js",
    "indexnow": "node scripts/indexnow.mjs",
    "build:i18n": "node scripts/i18n/snippet.mjs && node scripts/i18n/extract-ui.mjs && node scripts/i18n/build-runtime.mjs"
  },
  "dependencies": {
    "@google-cloud/bigquery": "^9.1.0",
    "body-parser": "^1.20.2",
    "dotenv": "^16.3.1",
    "express": "^4.18.2",
    "libphonenumber-js": "^1.13.13",
    "resend": "^0.17.0"
  },
  "devDependencies": {
    "flatpickr": "^4.6.13",
    "jsdom": "^22.1.0",
    "leaflet": "^1.9.4",
    "playwright": "^1.63.0"
  }
}
