# Copy this to .env and fill values for local testing
RESEND_API_KEY=your-resend-api-key
CONTACT_EMAIL=hello@rishikeshhomestays.com
PORT=3000

# BigQuery (enquiries storage)
# Local dev: point this at the downloaded service-account key (see credentials/README.md).
GOOGLE_APPLICATION_CREDENTIALS=credentials/bigquery-service-account.json
# Production (Vercel): paste the full service-account JSON content into this
# var instead — Vercel functions can't read a local file path.
# GOOGLE_APPLICATION_CREDENTIALS_JSON={"type":"service_account",...}
BIGQUERY_DATASET=rishikesh_homestays
BIGQUERY_ENQUIRIES_TABLE=enquiries

# Email OTP verification for the enquiry form (optional — if unset, the
# verify-email UI never appears and enquiries submit exactly as before).
# Set to any long random string; used to derive OTP codes, not a real secret
# shared with a third party. Uses RESEND_API_KEY above to send the code.
OTP_SECRET=
