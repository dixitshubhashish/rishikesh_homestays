# Environment
.env
.env.local
.env.*.local

# GCP / BigQuery service account keys — never commit credentials
*.json
!package.json
!package-lock.json
!vercel.json
# Translation catalogues and the files the browser fetches (no secrets)
!i18n/**/*.json
!i18n/**/*.json
# Site search index (built by scripts/search/build-index.mjs, fetched by the browser)
!assets/search/index.json
credentials/

# Dependencies
node_modules/
package-lock.json

# OS
.DS_Store
Thumbs.db

# Logs
*.log
npm-debug.log*
yarn-debug.log*

# IDE
.vscode/
.idea/
*.swp
*.swo

# Temp files
*.tmp
.cache/

# Media (large files)
*.mp4
*.mov
*.avi
*.webm
*.png
*.jpg
*.jpeg
!assets/images/*.png
!assets/images/*.jpg
!assets/images/*.ico
!assets/images/**/*.png
!assets/images/**/*.jpg

# stays crawl cache (raw crawl output, regenerated by scripts/stays/crawl.py)
scripts/stays/.cache/*
# stays.db is tracked (owner, 2026-10-14): committed so it's visible/pullable from GitHub,
# unlike the rest of this cache. Its own -wal/-shm journal files stay ignored (rebuilt by
# SQLite; never meaningful to commit); regenerate the tracked file with
# `node scripts/stays/migrate_to_db.mjs` (reads the committed docs/booking-links/*.tsv).
# (the blanket ".cache/" rule above also excludes this directory itself -- un-exclude it
# first so git will look inside for the two more specific rules that follow)
!scripts/stays/.cache/
!scripts/stays/.cache/stays.db
scripts/stays/.cache/stays.db-wal
scripts/stays/.cache/stays.db-shm

# Python bytecode (scripts/stays)
__pycache__/
